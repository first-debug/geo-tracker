# Базовый образ DeepStream (тот же, в котором ведётся разработка)
DS_IMAGE=nvcr.io/nvidia/deepstream:9.0-triton-multiarch
# Коммит DeepStream-Yolo, с которым проверена модель
DSYOLO_REF=master
# Тег образа sheremetevo-app
APP_VERSION=latest
# Конфиг из configs/, с которым запускается приложение
APP_CONFIG=app.ini
# Сколько секунд без обработанных кадров контейнер ещё считается здоровым
HEALTH_MAX_FRAME_AGE_SEC=60
# Уровень логов GStreamer: 1 — только ошибки, 2 — с предупреждениями
GST_DEBUG=1
TZ=Europe/Moscow
